 #include <uv.h>
 
+/*
+ * wakfu-memo PATCH - title matching accepts a suffix.
+ *
+ * The Wakfu client names its window after the connected character:
+ * "S'Alu-Ca'Va - WAKFU". The original exact comparison therefore only found the
+ * window before login, and never in multi-account, where every client carries a
+ * different name. We accept equality, or the sought title as a suffix preceded
+ * by " - ": strict enough not to be fooled by a browser tab sitting on a page
+ * that talks about the game.
+ */
+#define OW_TITLE_SEPARATOR " - "
+
+static inline bool ow_title_matches(const char* title, const char* target) {
+  if (title == NULL || target == NULL) return false;
+  if (strcmp(title, target) == 0) return true;
+
+  size_t title_len = strlen(title);
+  size_t target_len = strlen(target);
+  size_t separator_len = strlen(OW_TITLE_SEPARATOR);
+  if (target_len == 0 || title_len < target_len + separator_len) return false;
+
+  size_t suffix_at = title_len - target_len;
+  if (strcmp(title + suffix_at, target) != 0) return false;
+  return strncmp(title + suffix_at - separator_len, OW_TITLE_SEPARATOR, separator_len) == 0;
+}
+
 enum ow_event_type {
   // target window is found
   OW_ATTACH = 1,
@@ -68,6 +96,26 @@ void ow_activate_overlay();
 
 void ow_focus_target();
 
+/*
+ * wakfu-memo PATCH - click-through, set on the X server itself.
+ *
+ * `BrowserWindow.setIgnoreMouseEvents` is a no-op under Linux/X11 since
+ * Electron 43 (electron#52456): the transparent window keeps a full input
+ * region and swallows every click meant for the game. Reproduced on 42.9.3 too,
+ * so there is no way out through the version. We therefore set the region
+ * ourselves, here, where the library already knows the Overlay's X id.
+ *
+ * The region is a list of rectangles in window coordinates, so it survives
+ * moves and resizes:
+ *   - `count == 0`   : EMPTY region, every click passes through;
+ *   - `rects == NULL`: no region at all, the window takes its whole surface;
+ *   - otherwise      : only these rectangles catch clicks - that is the fiche,
+ *                      not the window covering the whole game.
+ *
+ * No effect outside X11: on Windows the Electron API works.
+ */
+void ow_set_input_region(const int32_t* rects, uint32_t count);
+
 void ow_emit_event(struct ow_event* event);
 
 void ow_screenshot(uint8_t* out, uint32_t width, uint32_t height);
