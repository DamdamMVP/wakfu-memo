diff --git a/src/lib/addon.c b/src/lib/addon.c
index ff6bbb0..80d86ac 100644
--- a/src/lib/addon.c
+++ b/src/lib/addon.c
@@ -201,6 +201,44 @@ napi_value AddonActivateOverlay(napi_env _env, napi_callback_info _info) {
   return NULL;
 }
 
+napi_value AddonSetInputRegion(napi_env env, napi_callback_info info) {
+  napi_status status;
+  size_t info_argc = 1;
+  napi_value info_argv[1];
+  status = napi_get_cb_info(env, info, &info_argc, info_argv, NULL, NULL);
+  NAPI_THROW_IF_FAILED(env, status, NULL);
+
+  /* null : pas de region, la fenetre reprend toute sa surface. */
+  bool is_typedarray = false;
+  status = napi_is_typedarray(env, info_argv[0], &is_typedarray);
+  NAPI_THROW_IF_FAILED(env, status, NULL);
+  if (!is_typedarray) {
+    ow_set_input_region(NULL, 0);
+    return NULL;
+  }
+
+  napi_typedarray_type type;
+  size_t length;
+  void* data;
+  status = napi_get_typedarray_info(env, info_argv[0], &type, &length, &data, NULL, NULL);
+  NAPI_THROW_IF_FAILED(env, status, NULL);
+  if (type != napi_int32_array) {
+    napi_throw_type_error(env, NULL, "setInputRegion attend un Int32Array");
+    return NULL;
+  }
+
+  /* ⚠️ Un tableau VIDE n'est pas l'absence de tableau : N-API rend alors un
+     pointeur nul, que `ow_set_input_region` lirait comme « pas de region » —
+     donc comme une fenetre qui attrape tout, l'inverse de ce qu'on demande.
+     On lui donne un pointeur qui ne sert pas, mais qui n'est pas nul. */
+  static const int32_t aucun_rectangle = 0;
+  const int32_t* premier = (data != NULL) ? (const int32_t*)data : &aucun_rectangle;
+
+  /* Quatre entiers par rectangle : x, y, largeur, hauteur. */
+  ow_set_input_region(premier, (uint32_t)(length / 4));
+  return NULL;
+}
+
 napi_value AddonFocusTarget(napi_env env, napi_callback_info info) {
   ow_focus_target();
   return NULL;
