+napi_value AddonSetInputRegion(napi_env env, napi_callback_info info) {
+  napi_status status;
+  size_t info_argc = 1;
+  napi_value info_argv[1];
+  status = napi_get_cb_info(env, info, &info_argc, info_argv, NULL, NULL);
+  NAPI_THROW_IF_FAILED(env, status, NULL);
+
+  /* null: no region at all, the window takes its whole surface back. */
+  bool is_typedarray = false;
+  status = napi_is_typedarray(env, info_argv[0], &is_typedarray);
+  NAPI_THROW_IF_FAILED(env, status, NULL);
+  if (!is_typedarray) {
+    ow_set_input_region(NULL, 0);
+    return NULL;
+  }
+
+  napi_typedarray_type type;
+  size_t length;
+  void* data;
+  status = napi_get_typedarray_info(env, info_argv[0], &type, &length, &data, NULL, NULL);
+  NAPI_THROW_IF_FAILED(env, status, NULL);
+  if (type != napi_int32_array) {
+    napi_throw_type_error(env, NULL, "setInputRegion expects an Int32Array");
+    return NULL;
+  }
+
+  /* An EMPTY array is not the absence of an array: N-API hands back a null
+     pointer, which `ow_set_input_region` would read as "no region" - that is, a
+     window catching everything, the exact opposite of what was asked. So we
+     give it a pointer that is never read, but is not null. */
+  static const int32_t aucun_rectangle = 0;
+  const int32_t* premier = (data != NULL) ? (const int32_t*)data : &aucun_rectangle;
+
+  /* Four integers per rectangle: x, y, width, height. */
+  ow_set_input_region(premier, (uint32_t)(length / 4));
+  return NULL;
+}
+
+napi_value AddonSetOverrideRedirect(napi_env env, napi_callback_info info) {
+  napi_status status;
+  size_t info_argc = 1;
+  napi_value info_argv[1];
+  status = napi_get_cb_info(env, info, &info_argc, info_argv, NULL, NULL);
+  NAPI_THROW_IF_FAILED(env, status, NULL);
+
+  /* The same Buffer `attachByTitle` takes: the X window id, four bytes. */
+  void* window_id = NULL;
+  size_t length = 0;
+  status = napi_get_buffer_info(env, info_argv[0], &window_id, &length);
+  NAPI_THROW_IF_FAILED(env, status, NULL);
+  if (window_id == NULL || length < sizeof(uint32_t)) {
+    napi_throw_type_error(env, NULL, "setOverrideRedirect expects a window handle Buffer");
+    return NULL;
+  }
+
+  ow_set_override_redirect(*((uint32_t*)window_id));
+  return NULL;
+}
