+void ow_set_override_redirect(uint32_t window_id) {
+  if (window_id == 0) {
+    return;
+  }
+  /* The hook thread may not have started yet: this is called while the window
+     is still unmapped, which is before `ow_start_hook`. A short-lived
+     connection of our own costs one round trip and removes the ordering
+     constraint entirely. */
+  xcb_connection_t* conn = x_conn;
+  bool own_connection = false;
+  if (conn == NULL) {
+    conn = xcb_connect(NULL, NULL);
+    if (xcb_connection_has_error(conn)) {
+      xcb_disconnect(conn);
+      return;
+    }
+    own_connection = true;
+  }
+
+  /* CHECKED, and not the usual fire-and-forget: `xcb_request_check` waits for
+     the server to have processed the request. Without it, the `xcb_disconnect`
+     below threw the request away before it ever reached the server, and the
+     attribute silently stayed at 0 - measured, and it cost an afternoon. */
+  uint32_t values[] = {1};
+  xcb_void_cookie_t cookie = xcb_change_window_attributes_checked(
+      conn, (xcb_window_t)window_id, XCB_CW_OVERRIDE_REDIRECT, values);
+  xcb_generic_error_t* error = xcb_request_check(conn, cookie);
+  if (error != NULL) {
+    free(error);
+  }
+
+  if (own_connection) {
+    xcb_disconnect(conn);
+  }
+}
+
+void ow_set_input_region(const int32_t* rects, uint32_t count) {
+  /* `x_conn` only exists once the watch thread has started, and we can be
+     called before that, on the Overlay's very first `appliquer()`. */
+  if (x_conn == NULL || overlay_info.window_id == XCB_WINDOW_NONE) {
+    return;
+  }
+  if (rects == NULL) {
+    /* Null mask = no shape: the window takes its whole surface back. */
+    xcb_shape_mask(x_conn, XCB_SHAPE_SO_SET, XCB_SHAPE_SK_INPUT,
+                   overlay_info.window_id, 0, 0, XCB_PIXMAP_NONE);
+    xcb_flush(x_conn);
+    return;
+  }
+
+  xcb_rectangle_t* shape = NULL;
+  if (count > 0) {
+    shape = malloc(sizeof(xcb_rectangle_t) * count);
+    if (shape == NULL) return;
+    for (uint32_t i = 0; i < count; i++) {
+      shape[i].x = (int16_t)rects[i * 4 + 0];
+      shape[i].y = (int16_t)rects[i * 4 + 1];
+      shape[i].width = (uint16_t)rects[i * 4 + 2];
+      shape[i].height = (uint16_t)rects[i * 4 + 3];
+    }
+  }
+  /* count == 0: empty region, everything passes through. */
+  xcb_shape_rectangles(x_conn, XCB_SHAPE_SO_SET, XCB_SHAPE_SK_INPUT,
+                       XCB_CLIP_ORDERING_UNSORTED, overlay_info.window_id, 0, 0, count, shape);
+  free(shape);
+  xcb_flush(x_conn);
+}
