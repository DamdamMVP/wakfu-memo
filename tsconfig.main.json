{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2023"],
    "types": ["node"],
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/.tsbuildinfo-main"
  },
  "include": ["src/main/**/*.ts", "src/pont/**/*.ts"],
  "exclude": ["**/*.test.ts"]
}
